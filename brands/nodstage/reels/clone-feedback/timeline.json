{
 "caps": [
  {
   "t": 0.0,
   "text": "Nod, a client just sent feedback."
  },
  {
   "t": 2.42,
   "text": "Four emails,"
  },
  {
   "t": 3.16,
   "text": "two voice notes"
  },
  {
   "t": 3.96,
   "text": "and a screenshot."
  },
  {
   "t": 5.68,
   "text": "Which version?"
  },
  {
   "t": 6.94,
   "text": "Nobody knows."
  },
  {
   "t": 8.22,
   "text": "Tell them how you handle it."
  },
  {
   "t": 10.1,
   "text": "A spreadsheet."
  },
  {
   "t": 10.9,
   "text": "Sticky notes."
  },
  {
   "t": 11.6,
   "text": "Three hours"
  },
  {
   "t": 12.02,
   "text": "of copy and paste."
  },
  {
   "t": 13.74,
   "text": "They want EASY."
  },
  {
   "t": 15.28,
   "text": "Then show them."
  },
  {
   "t": 16.62,
   "text": "Watch."
  },
  {
   "t": 17.56,
   "text": "Step one."
  },
  {
   "t": 18.16,
   "text": "Share the proof"
  },
  {
   "t": 18.62,
   "text": "in her portal."
  },
  {
   "t": 19.84,
   "text": "Does she need an account?"
  },
  {
   "t": 21.18,
   "text": "No."
  },
  {
   "t": 21.6,
   "text": "She clicks the work"
  },
  {
   "t": 22.28,
   "text": "and comments."
  },
  {
   "t": 23.54,
   "text": "Even voice notes?"
  },
  {
   "t": 24.96,
   "text": "Voice notes."
  },
  {
   "t": 25.6,
   "text": "Video."
  },
  {
   "t": 26.1,
   "text": "Arrows on the design."
  },
  {
   "t": 27.72,
   "text": "Step two."
  },
  {
   "t": 28.5,
   "text": "Every comment"
  },
  {
   "t": 29.0,
   "text": "becomes a task."
  },
  {
   "t": 30.46,
   "text": "With the pin?"
  },
  {
   "t": 31.46,
   "text": "Right where she left it."
  },
  {
   "t": 32.46,
   "text": "Assigned,"
  },
  {
   "t": 32.84,
   "text": "with a deadline."
  },
  {
   "t": 34.44,
   "text": "Step three."
  },
  {
   "t": 34.94,
   "text": "She asks for"
  },
  {
   "t": 35.5,
   "text": "something extra."
  },
  {
   "t": 36.96,
   "text": "Round five."
  },
  {
   "t": 37.92,
   "text": "It becomes a change order."
  },
  {
   "t": 39.1,
   "text": "She approves it."
  },
  {
   "t": 39.9,
   "text": "It lands on the invoice."
  },
  {
   "t": 41.8,
   "text": "Wait."
  },
  {
   "t": 42.06,
   "text": "Can my team use this too?"
  },
  {
   "t": 43.78,
   "text": "Yep."
  },
  {
   "t": 44.12,
   "text": "Clients and freelancers"
  },
  {
   "t": 44.92,
   "text": "you bring in are free."
  },
  {
   "t": 46.02,
   "text": "One price per studio."
  },
  {
   "t": 47.52,
   "text": "So I never chase"
  },
  {
   "t": 48.34,
   "text": "feedback again?"
  },
  {
   "t": 49.72,
   "text": "Less chasing."
  },
  {
   "t": 50.64,
   "text": "Clients are still clients."
  },
  {
   "t": 52.32,
   "text": "So the problem was me?"
  },
  {
   "t": 54.16,
   "text": "The problem was"
  },
  {
   "t": 55.02,
   "text": "[four inboxes]."
  }
 ],
