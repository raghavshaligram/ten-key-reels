  for (let i = 0; i < 9; i++) { const bx = i * 60 - 10, bh = 120 + (i * 61) % 150; g.fillStyle = ["#DCE3EA", "#E6E3EE", "#E9E1DA"][i % 3]; g.fillRect(bx, h * .62 - bh, 54, bh + 40); g.fillStyle = "rgba(255,255,255,.55)"; for (let y = h * .62 - bh + 12; y < h * .62; y += 22) for (let x = bx + 8; x < bx + 46; x += 14) g.fillRect(x, y, 7, 10); }
  g.fillStyle = "#BFD8B0"; for (let i = 0; i < 14; i++) { g.beginPath(); g.arc(i * 40 + 10, h * .66 + (i % 3) * 10, 34 + (i % 4) * 6, 0, 7); g.fill(); }
