  for (let i = 0; i < 7; i++) { const lf = new THREE.Mesh(new THREE.SphereGeometry(.2, 10, 8), M("#4C7A4E")); lf.scale.set(.5, 1.5, .5); lf.position.set(x + Math.cos(i) * .14, .75 + (i % 3) * .14, z + Math.sin(i) * .14); lf.rotation.z = Math.cos(i) * .5; scene.add(lf); } }
